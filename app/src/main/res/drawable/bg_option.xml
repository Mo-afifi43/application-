<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/nbRipple">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/nbPrimaryContainer" />
                    <stroke
                        android:width="2dp"
                        android:color="?attr/nbPrimary" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/nbSurface" />
                    <stroke
                        android:width="1dp"
                        android:color="?attr/nbDivider" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
