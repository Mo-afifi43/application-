<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/reader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/nbBackground">

    <ScrollView
        android:id="@+id/reader_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/reader_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp" />
        </FrameLayout>
    </ScrollView>

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/reader_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_reader_bar"
        android:elevation="4dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/reader_back"
                style="@style/Widget.Nibras.IconButton"
                android:contentDescription="@string/cd_back"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/reader_book_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Nibras.Caption" />

                <TextView
                    android:id="@+id/reader_chapter_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Nibras.Subtitle" />
            </LinearLayout>

            <ImageView
                android:id="@+id/reader_bookmark"
                style="@style/Widget.Nibras.IconButton"
                android:contentDescription="@string/cd_bookmark"
                android:src="@drawable/ic_bookmark_outline" />

            <ImageView
                android:id="@+id/reader_share"
                style="@style/Widget.Nibras.IconButton"
                android:contentDescription="@string/cd_share"
                android:src="@drawable/ic_share" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/reader_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="1000"
            android:progressDrawable="@drawable/progress_horizontal" />
    </LinearLayout>

    <!-- Bottom bar -->
    <LinearLayout
        android:id="@+id/reader_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reader_bar"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/reader_prev"
            style="@style/Widget.Nibras.IconButton"
            android:contentDescription="@string/cd_prev"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/reader_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Nibras.Caption" />

        <ImageView
            android:id="@+id/reader_contents"
            style="@style/Widget.Nibras.IconButton"
            android:contentDescription="@string/cd_contents"
            android:src="@drawable/ic_list" />

        <ImageView
            android:id="@+id/reader_settings"
            style="@style/Widget.Nibras.IconButton"
            android:contentDescription="@string/cd_settings"
            android:src="@drawable/ic_format_size" />

        <ImageView
            android:id="@+id/reader_next"
            style="@style/Widget.Nibras.IconButton"
            android:contentDescription="@string/cd_next"
            android:src="@drawable/ic_arrow_forward" />
    </LinearLayout>

    <!-- Contents panel -->
    <FrameLayout
        android:id="@+id/reader_toc_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/nbScrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/reader_toc_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingTop="10dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sheet_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="6dp"
                android:text="@string/reader_contents"
                android:textAppearance="@style/TextAppearance.Nibras.SectionTitle" />

            <ScrollView
                android:id="@+id/reader_toc_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/reader_toc_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="12dp" />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Reading settings panel -->
    <FrameLayout
        android:id="@+id/reader_settings_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/nbScrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/reader_settings_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_sheet_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/reader_settings"
                android:textAppearance="@style/TextAppearance.Nibras.SectionTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/reader_font_size"
                android:textAppearance="@style/TextAppearance.Nibras.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/font_decrease"
                    style="@style/Widget.Nibras.IconButton"
                    android:background="@drawable/bg_icon_button_filled"
                    android:contentDescription="@string/cd_decrease"
                    android:src="@drawable/ic_remove" />

                <SeekBar
                    android:id="@+id/font_seek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="12" />

                <ImageView
                    android:id="@+id/font_increase"
                    style="@style/Widget.Nibras.IconButton"
                    android:background="@drawable/bg_icon_button_filled"
                    android:contentDescription="@string/cd_increase"
                    android:src="@drawable/ic_add" />

                <TextView
                    android:id="@+id/font_value"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/plex_semibold"
                    android:gravity="center"
                    android:textColor="?attr/nbTextPrimary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/reader_theme"
                android:textAppearance="@style/TextAppearance.Nibras.Label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/theme_light"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/swatch_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/reader_theme_light"
                        android:textAppearance="@style/TextAppearance.Nibras.Caption" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/theme_sepia"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/swatch_sepia" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/reader_theme_sepia"
                        android:textAppearance="@style/TextAppearance.Nibras.Caption" />
                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:id="@+id/theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/swatch_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/reader_theme_dark"
                        android:textAppearance="@style/TextAppearance.Nibras.Caption" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reader_keep_screen"
                    android:textAppearance="@style/TextAppearance.Nibras.Subtitle" />

                <Switch
                    android:id="@+id/keep_screen_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
