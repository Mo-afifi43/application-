<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Nibras.Card.Clickable"
    android:layout_width="136dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/tile_icon_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_primary_container">

        <ImageView
            android:id="@+id/tile_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:tint="@color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/tile_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/plex_semibold"
        android:maxLines="2"
        android:textColor="?attr/nbTextPrimary"
        android:textSize="14.5sp" />

    <TextView
        android:id="@+id/tile_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Nibras.Caption" />
</LinearLayout>
