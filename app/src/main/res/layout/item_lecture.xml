<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Nibras.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/lecture_avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle_primary_container">

        <TextView
            android:id="@+id/lecture_initial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/heading"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lecture_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/plex_semibold"
            android:textColor="?attr/nbTextPrimary"
            android:textSize="15.5sp" />

        <TextView
            android:id="@+id/lecture_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Nibras.BodySecondary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/lecture_topics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/plex_medium"
            android:maxLines="1"
            android:textColor="?attr/nbPrimary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/lectures_open"
        android:src="@drawable/ic_youtube"
        android:tint="?attr/nbTextMuted" />
</LinearLayout>
