<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Nibras.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <com.mhma.nibras.ui.widget.CoverView
        android:id="@+id/online_cover"
        android:layout_width="@dimen/cover_thumb_width"
        android:layout_height="@dimen/cover_thumb_height"
        android:contentDescription="@string/cd_cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/online_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Nibras.Label" />

        <TextView
            android:id="@+id/online_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Nibras.Title"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/online_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Nibras.BodySecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/online_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="3"
            android:textAppearance="@style/TextAppearance.Nibras.BodySecondary"
            android:textSize="13.5sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_open_in_new"
                android:tint="?attr/nbPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/plex_medium"
                android:text="@string/classical_read_online"
                android:textColor="?attr/nbPrimary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
