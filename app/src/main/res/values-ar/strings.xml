    <!-- Classical library -->
    <string name="classical_title">المكتبة التراثية</string>
    <string name="classical_hero_title">مكتبة التراث</string>
    <string name="classical_hero_sub">أمهات كتب العلماء: صحيح البخاري ورياض الصالحين وتفسير ابن كثير وغيرها، تُقرأ كاملةً ومجانًا على موقع جامع الكتب الإسلامية. تُفتح الكتب في المتصفح.</string>
