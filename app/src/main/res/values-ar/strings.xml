    <!-- About -->
    <string name="about_title">عن نبراس</string>
    <string name="about_mission">نبراس مكتبة للمعرفة الإسلامية: كتب موثوقة، وقصص الأنبياء والصحابة، وأذكار يومية، ومحاضرات لعلماء موثوقين، تُقدَّم بالعناية التي تستحقها، بالعربية والإنجليزية.</string>
    <string name="about_feature_offline">يعمل دون اتصال بالإنترنت</string>
    <string name="about_feature_free">مجاني، بلا إعلانات ولا تتبّع</string>
    <string name="about_feature_bilingual">العربية والإنجليزية جنبًا إلى جنب</string>
    <string name="about_feature_authentic">مستمد من القرآن والسنة الصحيحة وعلم موثوق</string>
    <string name="about_sources_title">المصادر</string>
    <string name="about_sources_text">تفتح المكتبة التراثية أمهات كتب العلماء على موقع جامع الكتب الإسلامية (ketabonline.com)، وهو مكتبة رقمية مجانية للكتب الإسلامية. وقد رُوجع نص الأربعين النووية في نبراس على نسخته المحققة.</string>
    <string name="about_sources_open">زيارة موقع جامع الكتب الإسلامية</string>
    <string name="about_made_by">صُنع بحب بواسطة</string>
    <string name="about_note">إن لاحظت خطأً فشاركنا به ليُصحَّح، فالعلم أمانة.</string>
    <string name="about_dua">اللهم انفعنا بما علّمتنا، وعلّمنا ما ينفعنا.</string>

    <!-- Licences -->
    <string name="licenses_title">تراخيص المصادر المفتوحة</string>
    <string name="licenses_intro">بُني نبراس على إطار أندرويد ولغة كوتلن فقط. تُستخدم الخطوط التالية بموجب رخصة SIL للخطوط المفتوحة، الإصدار 1.1.</string>

