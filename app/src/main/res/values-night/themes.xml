<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark theme. Mirrors every role defined in values/themes.xml. -->
    <style name="Theme.Nibras.Base" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_950</item>
        <item name="android:colorPrimary">@color/mint_400</item>
        <item name="android:colorPrimaryDark">@color/night_950</item>
        <item name="android:colorAccent">@color/mint_400</item>
        <item name="android:colorControlActivated">@color/mint_400</item>
        <item name="android:colorControlNormal">@color/snow_400</item>
        <item name="android:colorControlHighlight">@color/ripple_dark</item>
        <item name="android:colorEdgeEffect">@color/mint_400</item>
        <item name="android:textColorPrimary">@color/snow_100</item>
        <item name="android:textColorSecondary">@color/snow_400</item>
        <item name="android:textColorTertiary">@color/snow_600</item>
        <item name="android:textColorHint">@color/snow_600</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Nibras.Activity</item>
        <item name="android:textViewStyle">@style/Widget.Nibras.TextView</item>
        <item name="android:buttonStyle">@style/Widget.Nibras.Button</item>
        <item name="android:editTextStyle">@style/Widget.Nibras.EditText</item>
        <item name="android:alertDialogTheme">@style/Theme.Nibras.Dialog</item>

        <item name="nbBackground">@color/night_950</item>
        <item name="nbSurface">@color/night_900</item>
        <item name="nbSurfaceVariant">@color/night_800</item>
        <item name="nbPrimary">@color/mint_400</item>
        <item name="nbOnPrimary">@color/night_950</item>
        <item name="nbPrimaryContainer">@color/mint_900</item>
        <item name="nbOnPrimaryContainer">@color/mint_100</item>
        <item name="nbAccent">@color/gold_400</item>
        <item name="nbAccentSoft">@color/night_800</item>
        <item name="nbTextPrimary">@color/snow_100</item>
        <item name="nbTextSecondary">@color/snow_400</item>
        <item name="nbTextMuted">@color/snow_600</item>
        <item name="nbDivider">@color/night_700</item>
        <item name="nbCardStroke">@color/night_700</item>
        <item name="nbQuoteBackground">@color/night_800</item>
        <item name="nbQuoteBorder">@color/gold_400</item>
        <item name="nbNavBackground">@color/night_900</item>
        <item name="nbRipple">@color/ripple_dark</item>
        <item name="nbHeroStart">@color/emerald_900</item>
        <item name="nbHeroEnd">@color/emerald_700</item>
        <item name="nbScrim">@color/scrim_dark</item>
    </style>

    <style name="Theme.Nibras.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/mint_400</item>
        <item name="android:colorPrimary">@color/mint_400</item>
        <item name="android:textColorPrimary">@color/snow_100</item>
        <item name="android:textColorSecondary">@color/snow_400</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textViewStyle">@style/Widget.Nibras.TextView</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.Nibras.DialogButton</item>
        <item name="nbBackground">@color/night_950</item>
        <item name="nbSurface">@color/night_900</item>
        <item name="nbSurfaceVariant">@color/night_800</item>
        <item name="nbPrimary">@color/mint_400</item>
        <item name="nbOnPrimary">@color/night_950</item>
        <item name="nbPrimaryContainer">@color/mint_900</item>
        <item name="nbOnPrimaryContainer">@color/mint_100</item>
        <item name="nbAccent">@color/gold_400</item>
        <item name="nbAccentSoft">@color/night_800</item>
        <item name="nbTextPrimary">@color/snow_100</item>
        <item name="nbTextSecondary">@color/snow_400</item>
        <item name="nbTextMuted">@color/snow_600</item>
        <item name="nbDivider">@color/night_700</item>
        <item name="nbCardStroke">@color/night_700</item>
        <item name="nbQuoteBackground">@color/night_800</item>
        <item name="nbQuoteBorder">@color/gold_400</item>
        <item name="nbNavBackground">@color/night_900</item>
        <item name="nbRipple">@color/ripple_dark</item>
        <item name="nbHeroStart">@color/emerald_900</item>
        <item name="nbHeroEnd">@color/emerald_700</item>
        <item name="nbScrim">@color/scrim_dark</item>
    </style>

    <style name="Theme.Nibras.Sheet" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowAnimationStyle">@style/Animation.Nibras.Sheet</item>
        <item name="android:colorAccent">@color/mint_400</item>
        <item name="android:colorControlActivated">@color/mint_400</item>
        <item name="android:textColorPrimary">@color/snow_100</item>
        <item name="android:textColorSecondary">@color/snow_400</item>
        <item name="android:textViewStyle">@style/Widget.Nibras.TextView</item>
        <item name="nbBackground">@color/night_950</item>
        <item name="nbSurface">@color/night_900</item>
        <item name="nbSurfaceVariant">@color/night_800</item>
        <item name="nbPrimary">@color/mint_400</item>
        <item name="nbOnPrimary">@color/night_950</item>
        <item name="nbPrimaryContainer">@color/mint_900</item>
        <item name="nbOnPrimaryContainer">@color/mint_100</item>
        <item name="nbAccent">@color/gold_400</item>
        <item name="nbAccentSoft">@color/night_800</item>
        <item name="nbTextPrimary">@color/snow_100</item>
        <item name="nbTextSecondary">@color/snow_400</item>
        <item name="nbTextMuted">@color/snow_600</item>
        <item name="nbDivider">@color/night_700</item>
        <item name="nbCardStroke">@color/night_700</item>
        <item name="nbQuoteBackground">@color/night_800</item>
        <item name="nbQuoteBorder">@color/gold_400</item>
        <item name="nbNavBackground">@color/night_900</item>
        <item name="nbRipple">@color/ripple_dark</item>
        <item name="nbHeroStart">@color/emerald_900</item>
        <item name="nbHeroEnd">@color/emerald_700</item>
        <item name="nbScrim">@color/scrim_dark</item>
    </style>
</resources>
