    <!-- About -->
    <string name="about_title">About Nibras</string>
    <string name="about_mission">Nibras is an Islamic knowledge library: authentic books, the stories of the Prophets and the Companions, daily remembrances and lectures from trusted scholars — presented with the care they deserve, in Arabic and English.</string>
    <string name="about_feature_offline">Works completely offline</string>
    <string name="about_feature_free">Free, with no ads and no tracking</string>
    <string name="about_feature_bilingual">Arabic and English, side by side</string>
    <string name="about_feature_authentic">Drawn from the Qur\'an, the authentic Sunnah and trusted scholarship</string>
    <string name="about_sources_title">Sources</string>
    <string name="about_sources_text">The classical library opens the great works of the scholars on Jami\' al-Kutub al-Islamiyya (ketabonline.com), a free digital library of Islamic books. The text of the Forty Hadith in Nibras was checked against its digitised edition.</string>
    <string name="about_sources_open">Visit ketabonline.com</string>
    <string name="about_made_by">Crafted with love by</string>
    <string name="about_note">If you notice a mistake, please share it so it can be corrected. Knowledge is a trust.</string>
    <string name="about_dua">O Allah, benefit us with what You have taught us, and teach us what benefits us.</string>

