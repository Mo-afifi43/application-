<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== Widgets ===== -->
    <style name="Widget.Nibras" parent="" />

    <!-- The default text appearance carries the interface font. It must be set
         through textAppearance (not fontFamily) so that TextViews can still
         pick a different appearance, such as the display face for titles. -->
    <style name="Widget.Nibras.TextView" parent="android:Widget.Material.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Nibras.Body</item>
    </style>

    <style name="Widget.Nibras.Button" parent="android:Widget.Material.Button">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Nibras.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Nibras.EditText" parent="android:Widget.Material.EditText">
        <item name="android:fontFamily">@font/nibras_ui</item>
    </style>

    <!-- Filled primary call-to-action -->
    <style name="Widget.Nibras.PrimaryButton" parent="Widget.Nibras.TextView">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textColor">?attr/nbOnPrimary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>



    <!-- 44dp circular icon button -->
    <style name="Widget.Nibras.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:tint">?attr/nbTextPrimary</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Card container -->
    <style name="Widget.Nibras.Card">
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="Widget.Nibras.Card.Clickable">
        <item name="android:background">@drawable/bg_card_clickable</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Filter chip (selection is toggled from code via android:selected) -->
    <style name="Widget.Nibras.Chip" parent="Widget.Nibras.TextView">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- Settings row -->
    <style name="Widget.Nibras.Row">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- ===== Text appearances ===== -->
    <style name="TextAppearance.Nibras.Display" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">?attr/nbTextPrimary</item>
    </style>

    <style name="TextAppearance.Nibras.Headline" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/nbTextPrimary</item>
    </style>

    <style name="TextAppearance.Nibras.Title" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/heading</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textColor">?attr/nbTextPrimary</item>
    </style>

    <style name="TextAppearance.Nibras.SectionTitle" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">?attr/nbTextPrimary</item>
    </style>

    <style name="TextAppearance.Nibras.Subtitle" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/plex_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/nbTextPrimary</item>
    </style>

    <style name="TextAppearance.Nibras.Body" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/nibras_ui</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/nbTextPrimary</item>
    </style>

    <style name="TextAppearance.Nibras.BodySecondary" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/nibras_ui</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/nbTextSecondary</item>
    </style>

    <style name="TextAppearance.Nibras.Caption" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/nibras_ui</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">?attr/nbTextMuted</item>
    </style>

    <style name="TextAppearance.Nibras.Label" parent="android:TextAppearance.Material">
        <item name="android:fontFamily">@font/plex_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/nbPrimary</item>
        <item name="android:letterSpacing">@dimen/label_letter_spacing</item>
    </style>

    <!-- ===== Animations ===== -->
    <style name="Animation.Nibras.Activity" parent="android:Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_stay</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_close_exit</item>
    </style>

    <style name="Animation.Nibras.Sheet" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/sheet_enter</item>
        <item name="android:windowExitAnimation">@anim/sheet_exit</item>
    </style>
</resources>
